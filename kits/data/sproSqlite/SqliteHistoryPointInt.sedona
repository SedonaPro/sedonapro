class SqliteHistoryPointInt extends SqliteHistoryPoint
{
	@summary=true
	property int value;

	@config
	property int updateDeadZone = 2;

	virtual override Str getStrValue()
	{
		return Sys.intStr(value);
	}

	virtual override bool needUpdate()
	{
		bool readyToPublish = false;
		if (publishInterval == 0.0) {
			readyToPublish = Math.abs(lastValue-value) > updateDeadZone;
		}
		readyToPublish = readyToPublish || super.needUpdate();
		if (readyToPublish)
			lastValue = value;
		return readyToPublish;
	}

	private int lastValue;
}
