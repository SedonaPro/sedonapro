@palette=false
class SqliteAlarmDatabase extends SqlitePoint
{
	virtual override SqliteDb getDatabase()
	{
		return db;
	}

	virtual override Str getDatabaseName()
	{
		return "alarms.sqlite";
	}

	virtual override int getInstanceCounter()
	{
		return instanceCounter;
	}

	virtual override void setInstanceCounter(int val)
	{
		instanceCounter = val;
	}

	static int minimalKeptEntriesValue   = 100;
	static int cleanAfterNewEntriesValue = 20;

	static inline SqliteDb db;
	static int instanceCounter;
}
