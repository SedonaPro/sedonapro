@palette=false
class SqliteAlarmLogicPoint extends SqliteAlarmDatabase
{

	@config
	property bool enable = false;

	@readonly
	@summary=true
	property bool active = false;

	@readonly
	property bool alarm = false;

	property bool reset = false;

	@config
	@allowNull=false
	property bool autoReset = false;


	@unit=Units.second
	@min = 0
	@config property float delay = 5.0;

	virtual void checkAlarmState()
	{
		if (!alarmInternalState || !enable) {
			alarmStartTime = Sys.ticks();
			active := false;
		}
		else
			if (Sys.ticks() - alarmStartTime > 1sec*(long)delay)
				active := true;
	}

	action void resetAlarm()
	{
		alarm := false;
	}

	void resetAllAlarmChildren(Component parent)
	{
		Component c = Sys.app.lookup(parent.children);
		for (; c != null; c = Sys.app.lookup(c.nextSibling)) {
			if (c.type.is(SqliteAlarmPoint.type)) {
				SqliteAlarmPoint pnt = (SqliteAlarmPoint)c;
				pnt.resetAlarm();
			}
			resetAllAlarmChildren(c);
		}
	}

	@confirmRequired
	action void resetAllAlarms()
	{
		Component root = Sys.app.lookup(0);
		resetAllAlarmChildren(root);
	}


	virtual void newAlarm()
	{
		alarm := true;
	}

	virtual override void doWork(SqliteDb db)
	{
		super.doWork(db);

		checkAlarmState();
		if (lastActive != active)
			if (active)
				newAlarm();
		lastActive = active;

		// reset logic
		if (autoReset && !active)
			alarm := false;
		if (reset == true)
			alarm := false;
	}


	private bool lastActive = false;
        private long alarmStartTime = 0L;

	protected bool alarmInternalState = false;
}
