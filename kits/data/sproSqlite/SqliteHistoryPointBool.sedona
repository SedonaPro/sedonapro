class SqliteHistoryPointBool extends SqliteHistoryPoint
{
	@summary=true
	property bool value;

	virtual override Str getStrValue()
	{
		int tmp = BoolToInt.boolToInt(value);
		return Sys.intStr(tmp);
	}

	virtual override bool needUpdate()
	{
		bool readyToPublish = false;
		if (publishInterval == 0.0) {
			readyToPublish = value != lastValue;
			lastValue = value;
		}
		return readyToPublish || super.needUpdate();
	}

	private bool lastValue;
}
