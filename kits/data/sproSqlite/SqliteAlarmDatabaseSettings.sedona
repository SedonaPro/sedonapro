class SqliteAlarmDatabaseSettings extends Component
{
	@summary=true
	@config
	@min = 50
	property int minEntries = 100;

	@summary=true
	@config
	@min = 20
	property int cleanNewEntries = 20;

	void updateBackend()
	{
		SqliteAlarmDatabase.minimalKeptEntriesValue   = minEntries;
		SqliteAlarmDatabase.cleanAfterNewEntriesValue = cleanNewEntries;
	}

	virtual override void loaded()
	{
		super.loaded();
		updateBackend();
	}

	virtual override void changed(Slot slot)
	{
		super.changed(slot);
		updateBackend();
	}
}
