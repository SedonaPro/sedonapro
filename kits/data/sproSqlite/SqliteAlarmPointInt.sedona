class SqliteAlarmPointInt extends SqliteAlarmPointNum
{
	@summary=true
	property int in;

	virtual override float getFloatValue()
	{
		return (float)in;
	}

	virtual override Str getStrValue()
	{
		return Sys.intStr(in);
	}
}
