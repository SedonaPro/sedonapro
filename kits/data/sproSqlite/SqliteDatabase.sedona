@palette=false
class SqliteDatabase extends Component
{
	virtual SqliteDb getDatabase()
	{
		return null;
	}

	virtual Str getDatabaseName()
	{
		return "";
	}

	virtual int getInstanceCounter()
	{
		return 0;
	}

	virtual void setInstanceCounter(int val)
	{
	}

	int getDatabaseInstance()
	{
		int ret = 0;
		if (!getDatabase().isOpen()) {
			Sys.out.print("SqliteDatabase: getDatabaseInstance called for closed db");
			ret = -1;
		} else {
			int val = getInstanceCounter();
			val = val + 1;
			setInstanceCounter(val);
			ret = val;
		}
		return ret;
	}


	int putDatabaseInstance()
	{
		int ret = 0;
		if (!getDatabase().isOpen()) {
			Sys.out.print("SqliteDatabase: putDatabaseInstance called for closed db");
			ret = -1;
		} else {
			int val = getInstanceCounter();
			if (val >= 0) {
				val = val - 1;
				ret = val;
			} else {
				Sys.out.print("SqliteDatabase: no available instances to put");
				val = 0;
				ret = -1;
			}
			setInstanceCounter(val);
		}
		return ret;
	}

	virtual override void loaded()
	{
		super.loaded();
		SqliteDb db;
		db = getDatabase();
		if (!db.isOpen()) {
			db.open(getDatabaseName());
		}
		if (db.isOpen())
			getDatabaseInstance();
	}

	virtual override void stop()
	{
		super.stop();
		if (getDatabase().isOpen() && (putDatabaseInstance()==0)) {
			getDatabase().close();
		}
	}
}
