class SqliteAlarmPointBool extends SqliteAlarmPoint
{
	@summary=true
	property bool in;

	@summary=true
	property bool feedback;

	virtual override Str getStrValue()
	{
		return (in == true) ? "1" : "0";
	}

	virtual override void checkAlarmState()
	{
		if (feedbackInUse)
			alarmInternalState = (in == true) && (feedback != in);
		else
			alarmInternalState = (in == true);
		super.checkAlarmState();
	}

	virtual override int linkEvent(int eType, Link link)
	{
		if (link.toSlot == SqliteAlarmPointBool.feedback.id)
			feedbackInUse = (eType == ADDED);
		return super.linkEvent(eType, link);
	}

	bool feedbackInUse;
}
