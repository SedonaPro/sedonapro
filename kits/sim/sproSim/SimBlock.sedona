** Base for direct children of SimClock. All durations are seconds.
abstract class SimBlock extends Component
{
  @config property int phase = 2
  virtual override void execute() {}
  virtual bool valid() { return phase >= 0 && phase < 8 }
  virtual void resetState() {}
  virtual bool acceptsInput(Slot slot) { return false }
  abstract void tick(float dt, double time)

  static bool finite(float x) { return x == x && x > -3.4e38f && x < 3.4e38f }
  static float clamp(float x, float lo, float hi)
  {
    if (x < lo) return lo
    if (x > hi) return hi
    return x
  }
}


