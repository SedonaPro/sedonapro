@palette=false
class ExpressionBase extends Component
{
	@readonly
	property bool ok = false;

	@asStr
	@summary=true
	@config
	property Buf(maxExprLen) expr;


	virtual bool parseExpression()
	{
		AST = null;
		return false;
	}

	virtual void calcExpression()
	{
	}


	virtual void freeExpression()
	{
		AST = null;
		ok := false;
	}

	virtual override void loaded()
	{
		super.loaded();
		ok := parseExpression();
	}

	virtual override void stop()
	{
		super.stop();
		freeExpression();
	}

	virtual override void changed(Slot slot)
	{
		super.changed(slot);
		if (slot == ExpressionBase.expr) {
			freeExpression();
			ok := parseExpression();
			needUpdate = ok;
		}
	}

	virtual override void execute()
	{
		super.execute();
		if (needUpdate) {
			needUpdate = false;
			if (AST != null)
				calcExpression();
		}
	}

	define int maxExprLen = 255;
	define int maxParams = 8;

	Obj AST = null;
	bool needUpdate = true;

}
