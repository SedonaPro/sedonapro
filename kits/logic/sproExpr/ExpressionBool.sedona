class ExpressionBool extends ExpressionBase
{
	@readonly
	@summary=true
	property bool out;

	@summary=true
	property bool in1 = null;

	@summary=true
	property bool in2 = null;

	@summary=true
	property bool in3 = null;

	@summary=true
	property bool in4 = null;

	property bool in5 = null;

	property bool in6 = null;

	property bool in7 = null;

	property bool in8 = null;

	static private native Obj    doParse(Str expression);
	static private native Obj    doFree(Obj handle);
	static private native bool   doCalc(Obj handle, bool[] p, int paramsLen);


	virtual override bool parseExpression()
	{
		AST = doParse(expr.toStr());
		out := null;
		return AST != null;
	}

	virtual override void calcExpression()
	{
		params[0] = in1;
		params[1] = in2;
		params[2] = in3;
		params[3] = in4;
		params[4] = in5;
		params[5] = in6;
		params[6] = in7;
		params[7] = in8;
		out := doCalc(AST, params, maxParams);
	}

	virtual override void changed(Slot slot)
	{
		super.changed(slot);
		if ((slot == ExpressionFloat.in1) ||
		    (slot == ExpressionFloat.in2) ||
		    (slot == ExpressionFloat.in3) ||
		    (slot == ExpressionFloat.in4) ||
		    (slot == ExpressionFloat.in5) ||
		    (slot == ExpressionFloat.in6) ||
		    (slot == ExpressionFloat.in7) ||
		    (slot == ExpressionFloat.in8)) {
			needUpdate = true;
		}
	}

	virtual override void freeExpression()
	{
		if (AST != null)
			doFree(AST);
		super.freeExpression();
	}

	inline bool[ExpressionBase.maxParams] params;
}
