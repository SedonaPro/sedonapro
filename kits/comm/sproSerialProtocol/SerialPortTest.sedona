@palette=false
public class SerialPortDebug extends DebugComponent
{
	property bool update;

	int isOpen;	
	
	inline SerialPort port;
	inline SerialInStream in;
	inline SerialOutStream out;

	virtual override void loaded()
	{
		port.setParams(4, 115200, 8, 1, SerialPort.PARITY_NONE, SerialPort.RTS_LOW, SerialPort.RS232);
		isOpen = port.open();
		if (isOpen==0) {
			in.port = port;
			out.port = port;
		}
		
	}

	virtual override void execute()
	{
		int b;
		super.execute();

		if (isOpen!=0)
			return;
		
		b = in.read();
		if (b>=0) {
		   printMessage("");
		   Sys.out.print("${b}").nl();
		}
	}


	virtual override void changed(Slot slot)
	{
		super.changed(slot);

		if (isOpen==0)
			out.write(33);
	}

	virtual override void stop() 
	{
		super.stop();
		port.close();
	}
}		
