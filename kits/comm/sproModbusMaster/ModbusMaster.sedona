	@range = modbusRegsReadFuncs
	@min = 0
	property int modbusFunc = 0;

	virtual override void enumToModbusFunc()
	{
		switch(modbusFunc) {
			case 0:
				func = modbusReadHoldingRegisters;
				break;
			case 1:
				func = modbusReadInputRegisters;
				break;
			default:
				/* reset to correct value */
				func = modbusReadHoldingRegisters;
				modbusFunc := 0;
				break;
		}
	}

	virtual override void loaded() {
		super.loaded();
		enumToModbusFunc();
	}
}

@palette=false
class ModbusWritePointNumeric extends ModbusWritePoint
{
	define Str modbusRegsWriteFuncs = "writeSingleHoldingRegister, writeMultipleHoldingRegisters";

	@summary=false
	@config
	@range = modbusRegsWriteFuncs
	@min = 0
	property int modbusFunc = 1;

	@summary=false
	@config
	@min = 0
	property float updateThreshold = 0.0;

	virtual override void enumToModbusFunc()
	{
		switch(modbusFunc) {
			case 0:
				func = modbusWriteSingleHoldingRegister;
				break;
			case 1:
				func = modbusWriteMultipleHoldingRegisters;
				break;
			default:
				/* reset to correct value */
				func = modbusWriteMultipleHoldingRegisters;
				modbusFunc := 1;
				break;
		}
	}

	virtual override void loaded() {
		super.loaded();
		enumToModbusFunc();
	}
}

@palette=false
class ModbusReadPointInteger extends ModbusReadPointNumeric
{
	@config
	property float k = 1.0;

	@config
	property float b = 0.0;

	@summary=true
	@readonly
	property float fout;

	virtual float getOutData() {
		return 0.0;
	}

	virtual override void processDataAfterRead() {
		fout := getOutData()*k + b;
	}
}

@niagaraIcon="module://icons/x16/control/numericPoint.png"
class ModbusReadPointDWord extends ModbusReadPointInteger
{
	@summary=true
	@readonly
	property long out;

	virtual override void loaded() {
		super.loaded();
		dataLen = 2;
	}

	virtual override float getOutData()
	{
		return (float)out;
	}

	virtual override void processDataAfterRead()
	{
		out := ((long)data) & (0xFFFFFFFFL);
		super.processDataAfterRead();
	}
}

@niagaraIcon="module://icons/x16/control/numericPoint.png"
class ModbusReadPointWord extends ModbusReadPointInteger
{
	@readonly
	property int out;

	virtual override void loaded() {
		super.loaded();
		dataLen = 1;
	}

	virtual override float getOutData()
	{
		return (float)out;
	}

	virtual override void processDataAfterRead()
	{
		out := data & (0xFFFF);
		super.processDataAfterRead();
	}
}

@niagaraIcon="module://icons/x16/control/numericPoint.png"
class ModbusReadPointInt extends ModbusReadPointInteger
{
	@readonly
	property int out;

	@config
	@min = 1
	@max = 2
	property int numRegs = 1;

	virtual override void loaded() {
		super.loaded();
		dataLen = numRegs;
	}

	virtual override float getOutData()
	{
		return (float)out;
	}

	virtual override void processDataAfterRead()
	{
		if (dataLen == 1) {
			out := UWord2SWord.uWord2SWord(data & 0xFFFF);
		} else {
			out := data;
		}
		super.processDataAfterRead();
	}

	virtual override void changed(Slot slot)
	{
		super.changed(slot);

		if (slot == ModbusReadPointInt.numRegs) {
			dataLen = numRegs;
			updateBackendInfo();
		}
	}
}


@niagaraIcon="module://icons/x16/control/numericPoint.png"
class ModbusReadPointFloat extends ModbusReadPointNumeric
{
	@readonly
	property float out;

	virtual override void loaded() {
		super.loaded();
		dataLen = 2;
	}

	virtual override void processDataAfterRead()
	{
		out := Sys.bitsToFloat(data);
	}
}


@niagaraIcon="module://icons/x16/control/numericPointWr.png"
class ModbusWritePointDWord extends ModbusWritePointNumeric
{
	property int in;

	int lastValue;

	virtual override void printInternalStateBase()
	{
		super.printInternalStateBase();
		printMessage(""); Sys.out.print("lastValue         ${lastValue}").nl();
	}

	virtual override void loaded() {
		super.loaded();
		dataLen = 2;
	}

	virtual override void prepareDataBeforeWrite()
	{
		data = in;
	}

	virtual override bool needUpdateOnChange()
	{
		bool ret = false;
		if (Math.abs(lastValue - in) > (int)updateThreshold) {
			lastValue = in;
			ret = true;
		}
		return ret;
	}
}


@niagaraIcon="module://icons/x16/control/numericPointWr.png"
class ModbusWritePointWord extends ModbusWritePointDWord
{
	virtual override void loaded() {
		super.loaded();
		dataLen = 1;
	}

	virtual override void prepareDataBeforeWrite()
	{
		data = in & 0xFFFF;
	}

}


@niagaraIcon="module://icons/x16/control/numericPointWr.png"
class ModbusWritePointFloat extends ModbusWritePointNumeric
{
	property float in;

	float lastValue;

	virtual override void printInternalStateBase()
	{
		super.printInternalStateBase();
		printMessage(""); Sys.out.print("lastValue         ${lastValue}").nl();
	}

	virtual override void loaded() {
		super.loaded();
		dataLen = 2;
	}

	virtual override void prepareDataBeforeWrite()
	{
		data = Sys.floatToBits(in);
	}

	virtual override bool needUpdateOnChange()
	{
		bool ret = false;
		if (Math.fabs(lastValue - in) > updateThreshold) {
			lastValue = in;
			ret = true;
		}
		return ret;
	}
}



@niagaraIcon="module://icons/x16/device.png"
class ModbusSlaveDevice extends ModbusStatistic
{
	define Str statusVals="Down, Failed, Ok";

	define int statusDown = 0;
	define int statusFailed = 1;
	define int statusOk = 2;

	@summary=true
	@readonly
	@allowNull=false
	property bool fault = true;

	@summary=true
	@readonly
	@range=statusVals
	property int status = statusDown;

	@summary=false
	@config
	@allowNull=false
	@defaultOnClone
	property bool enable = false;

	@summary=true
	@config
	@min = 0
	@max = 247
	property int address = -1;

	@summary=false
	@config
	@allowNull=false
	property bool swapWords = true;

	@summary=false
	@config
	@allowNull=false
	property bool swapBytes = false;


	ModbusSlaveNetwork net = null;

	bool started = false;

	/*********************************** actions  ***************************************/

	action void printInternalState()
	{
		printMessage(""); Sys.out.print("started           ${started}").nl();
		printMessage(""); Sys.out.print("net               ").printBool(net != null).nl();
	}

	action void forceRequestsOnce()
	{
		forceRequests();
	}


	/************************* external accessors ***************************************/

	ModbusSlaveNetwork getModbusNet()
	{
		return net;
	}

	int getAddress()
	{
		return address;
	}



	void setDevAddress(int devAddress)
	{
		// printMessage("");
		// Sys.out.print(" ${devAddress}"); Sys.out.nl();

		Component c = Sys.app.lookup(children);
		for (; c != null; c = Sys.app.lookup(c.nextSibling)) {
			if (c.type.is(ModbusPoint.type)) {
				ModbusPoint pnt = (ModbusPoint)c;
				pnt.updateBackendInfo();
			}
		}
	}

	void setParentEnable()
	{
		updateStatus();

		Component c = Sys.app.lookup(children);
		for (; c != null; c = Sys.app.lookup(c.nextSibling)) {
			if (c.type.is(ModbusPoint.type)) {
				ModbusPoint pnt = (ModbusPoint)c;
				pnt.updateStatus();
			}
		}
	}

	void forceRequests()
	{
		Component c = Sys.app.lookup(children);
		for (; c != null; c = Sys.app.lookup(c.nextSibling)) {
			if (c.type.is(ModbusPoint.type)) {
				ModbusPoint pnt = (ModbusPoint)c;
				pnt.forceRequest();
			}
		}
	}


	void startBackend()
	{
		Component c = Sys.app.lookup(children);
		for (; c != null; c = Sys.app.lookup(c.nextSibling)) {
			if (c.type.is(ModbusPoint.type)) {
				ModbusPoint pnt = (ModbusPoint)c;
				pnt.startBackend();
			}
		}
		started = true;
	}


	/************************************************************************************/
	bool getParentEnable()
	{
		return net != null ? net.enable : false;
	}

	void updateStatus()
	{

		int st = statusDown;

		if (!getParentEnable() || !enable) {
			status := statusDown;
			return;
		}

		if (net == null) {
			status := statusFailed;
		}
		else {
			bool failed = false;
			Component c = Sys.app.lookup(children);
			for (; c != null; c = Sys.app.lookup(c.nextSibling)) {
				if (c.type.is(ModbusPoint.type)) {
					ModbusPoint pnt = (ModbusPoint)c;
					if (pnt.status == statusOk) {
						st = statusOk;
						break;
					}

					if (pnt.status == statusFailed)
						st = statusFailed;
				}
			}
		}

		fault := (st == statusFailed);
		status := st;
	}



	virtual override bool allowChildExecute()
	{
		return enable;
	}


	virtual override void loaded()
	{
		super.loaded();
		Component comp = Sys.app.lookup(parent);
		if (comp?.type?.is(ModbusSlaveNetwork.type) == true) {
			net = (ModbusSlaveNetwork)comp;
			if (net.started)
				startBackend();
		}
		updateStatus();
	}

	virtual override void execute()
	{
		super.execute();
		updateStatus();
		updateStatistic();
	}

	virtual override void changed(Slot slot)
	{
		super.changed(slot);

		if (slot == ModbusSlaveDevice.address)
			setDevAddress(address);

		if (slot == ModbusSlaveDevice.enable)
			setParentEnable();
	}
}

@palette=false
@niagaraIcon="module://icons/x16/deviceNetwork.png"
class ModbusSlaveNetwork extends ModbusStatistic
{
	define  int defaultPollPeriodMs = 1000;

	@summary=true
	@readonly
	@range=ModbusSlaveDevice.statusVals
        property int status = ModbusSlaveDevice.statusDown;


	@summary=false
	@config
        @min=100
        @unit=Units.millisecond
        property short timeOut = 500;


	@config
	@allowNull=false
	@defaultOnClone
        property bool enable = false;

	@summary=false
	@config
        @allowNull=false
        property bool writeOnUp = false;

	@summary=false
	@config
	@unit=Units.millisecond
	property int pollPeriodMs = defaultPollPeriodMs;

	Obj  modbusHandle = null;
	bool started = false;

	virtual override bool allowChildExecute()
	{
		return enable;
	}

	/************************************** native ****************************************/

	native void setQuit(Obj modbusHandle);
	native int  getStatus(Obj modbusHandle);
	native void setEnable(Obj modbusHandle, bool en);
	native void printInternalStateNative(Obj modbusHandle);
	native void printInternalStateNativeAll();

	/************************************** actions ***************************************/

	action void printInternalStateBackendAll()
	{
		printInternalStateNativeAll();
	}

	action void printInternalStateBackend()
	{
		if (modbusHandle != null)
			printInternalStateNative(modbusHandle);
	}

	action void printInternalState()
	{
		printMessage(""); Sys.out.print("modbusHandle    0x").print((modbusHandle != null ? "allocated" : "null")).nl();
		printMessage(""); Sys.out.print("started         ${started}").nl();
	}

	/************************* external accessors ***************************************/

	void setParentEnable()
	{
		// printMessage("setParentEnable"); Sys.out.nl();

		Component c = Sys.app.lookup(children);
		for (; c != null; c = Sys.app.lookup(c.nextSibling)) {
			if (c.type.is(ModbusSlaveDevice.type)) {
				ModbusSlaveDevice dev = (ModbusSlaveDevice)c;
				dev.setParentEnable();
			}
		}
	}

	void forceRequests()
	{
		// printMessage("forceRequests"); Sys.out.nl();

		Component c = Sys.app.lookup(children);
		for (; c != null; c = Sys.app.lookup(c.nextSibling)) {
			if (c.type.is(ModbusSlaveDevice.type)) {
				ModbusSlaveDevice dev = (ModbusSlaveDevice)c;
				dev.forceRequests();
			}
		}
	}


	/************************************************************************************/
	void updateEnable()
	{
		setParentEnable();
		if (modbusHandle != null)
			setEnable(modbusHandle, enable);
	}


	void updateStatus()
	{
		if (modbusHandle == null) {
			status := ModbusSlaveDevice.statusFailed;
			return;
		}

		if (!enable) {
			status := ModbusSlaveDevice.statusDown;
			return
		}

		status := getStatus(modbusHandle);
	}

	virtual void startBackend()
	{
		Component c = Sys.app.lookup(children);
		for (; c != null; c = Sys.app.lookup(c.nextSibling)) {
			if (c.type.is(ModbusSlaveDevice.type)) {
				ModbusSlaveDevice dev = (ModbusSlaveDevice)c;
				dev.startBackend();
			}
		}

		if (modbusHandle != null)
			setEnable(modbusHandle, enable);

		if (writeOnUp && enable)
			forceRequests();
		started = true;
	}

	virtual override void stop()
	{
		super.stop();
		if (modbusHandle != null) {
			setQuit(modbusHandle);
			modbusHandle = null;
		}
	}


	virtual override void changed(Slot slot)
	{
		super.changed(slot);
		if (slot == ModbusSlaveNetwork.enable)
			updateEnable();
	}

	virtual override void execute()
	{
		super.execute();

		if (!started)
			startBackend();

		updateStatistic();
		updateStatus();
	}
}


@niagaraIcon="module://icons/x16/deviceNetwork.png"
class ModbusSlaveTcpAsyncNetwork extends ModbusSlaveNetwork
{
	@summary=true
	@config
	@asStr
	@max = 46
	property Buf(46) ipAddress = "###.###.###.###";

	@summary=false
	@config
	property int port = 502;

	native  Obj addNetwork(Slot ip, int port);

	native  int updateTcpSettings(
		Obj modbusHandle,
		Slot ip,
		int port);


	virtual override void startBackend()
	{
		modbusHandle = addNetwork(ModbusSlaveTcpAsyncNetwork.ipAddress, port);
		super.startBackend();
	}


	virtual override void changed(Slot slot)
	{
                super.changed(slot);
		if ((slot == ModbusSlaveTcpAsyncNetwork.ipAddress) ||
		   (slot == ModbusSlaveTcpAsyncNetwork.port)){
			if (modbusHandle != null) {
				updateTcpSettings(modbusHandle,
						  ModbusSlaveTcpAsyncNetwork.ipAddress,
						  port);
			}
		}
	}

	virtual override void execute()
	{
		super.execute();
	}

}


@niagaraIcon="module://icons/x16/deviceNetwork.png"
class ModbusSlaveSerialAsyncNetwork extends ModbusSlaveNetwork
{
	@summary=false
	@config
	property int port = 0;

	@summary=false
	@config
	@range=SerialInfo.baudrateVals
        @min=0
        @max=2
        property int baudrate = 3;

	@summary=false
	@config
        @min=7
        @max=8
        property int databits = 8;

	@summary=false
	@config
        @min=1
        @max=2
        property int stopbits = 1;

	@summary=false
	@config
        @min=0
        @max=2
        @range=SerialInfo.parityVals
        property int parity = 2;

	@summary=false
	@config
	@range=SerialInfo.rtsModeVals
	@min=0
	@max=2
        property int rtsMode = SerialInfo.rtsModeNone;

	native Obj addNetwork(
		int  port,
		int  baudrate,
		int  databits,
		int  parity,
		int  stopbits,
		int  rtsMode
		);

	native void updateSerialSettings(
		Obj  modbusHandle,
		int  port,
		int  baudrate,
		int  databits,
		int  parity,
		int  stopbits,
		int  rtsMode);



	virtual override void startBackend()
	{
	        modbusHandle = addNetwork(port, baudrate, databits, parity, stopbits, rtsMode);
		super.startBackend();
	}


	virtual override void changed(Slot slot) {
                super.changed(slot);
		if ((
			(slot == ModbusSlaveSerialAsyncNetwork.port)     ||
			(slot == ModbusSlaveSerialAsyncNetwork.baudrate) ||
			(slot == ModbusSlaveSerialAsyncNetwork.databits) ||
			(slot == ModbusSlaveSerialAsyncNetwork.parity)   ||
			(slot == ModbusSlaveSerialAsyncNetwork.stopbits) ||
			(slot == ModbusSlaveSerialAsyncNetwork.rtsMode)
			    ) && (modbusHandle != null)) {

			updateSerialSettings(modbusHandle,
					     port,
					     baudrate,
					     databits,
					     parity,
					     stopbits,
					     rtsMode);

		}
	}
}
