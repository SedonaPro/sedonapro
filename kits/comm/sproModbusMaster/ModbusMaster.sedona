@palette=false
class ModbusStatistic extends DebugComponent
{
	@summary=false
	@readonly
	property int totalRequests;

	@summary=false
	@readonly
	property int totalErrors;

	action void resetStats()
	{
		totalRequests := 0;
		totalErrors := 0;

		Component c = Sys.app.lookup(children);
		for (; c != null; c = Sys.app.lookup(c.nextSibling)) {
			if (c.type.is(ModbusStatistic.type)) {
				ModbusStatistic dev;
				dev = (ModbusStatistic)c;
				dev.resetStats();
			}
		}
	}

	define int updateStatPeriodS = 3;

	long lastStatUpdate;

	void updateStatisticChildren()
	{
		int sum = 0;
		int sumErr = 0;
		Component c = Sys.app.lookup(children);
		for (; c != null; c = Sys.app.lookup(c.nextSibling)) {
			if (c.type.findSlot("totalRequests") != null) {
				sum    += c.getInt(c.type.findSlot("totalRequests"));
				sumErr += c.getInt(c.type.findSlot("totalErrors"));
			}
		}
		totalRequests := sum;
		totalErrors := sumErr;
	}


	void updateStatistic()
	{
		long curNs = Sys.ticks();
		long periodNs = (long)updateStatPeriodS * (long)(1000 * 1000 * 1000);
		if ((curNs - lastStatUpdate) > periodNs)
			updateStatisticChildren();
	}
}

@palette=false
class ModbusPoint extends ModbusStatistic
{
	define Str statusVals="Down, Failed, Ok";

	define int statusDown = 0;
	define int statusFailed = 1;
	define int statusOk = 2;


	define int modbusReadCoils = 1;
	define int modbusReadDiscreteInputs = 2;
	define int modbusWriteSingleCoil = 5;
	define int modbusWriteMultipleCoils = 15;
	define int modbusReadHoldingRegisters = 3;
	define int modbusReadInputRegisters = 4;
	define int modbusWriteSingleHoldingRegister = 6;
	define int modbusWriteMultipleHoldingRegisters = 16;


	define int errStatusCntMax = 3;


	@readonly
	property bool fault;

	@readonly
	@range = statusVals
	property int  status = statusDown;

	@config
	property int address = -1;

	@summary=false
	@readonly
	property int  actualUpdatePeriodMs;

	int  data;

	int  dataLen = 1;

	long lastUpdate;

	int  lastStatus;

	int  failStatusCnt;
	int  downStatusCnt;

	Obj  modbusRegHandle = null;

	ModbusSlaveNetwork net = null;
	ModbusSlaveDevice  dev = null;
	bool started = false;

	int  func = modbusReadCoils;

	static inline int[1] tmp_data;
	static inline int[1] tmp_status;

	/*************************** native functions ***********************************/

	native void removeRegister(Obj modbusHandle, Obj modbusRegHandle);
	native  Obj addRegister(Obj modbusHandle,
		  	        int devAddress,
				int func,
				int regAddress,
				int len);

	native void updateRegisterInfo(Obj modbusRegHandle,
			       int devAddress,
			       int func,
			       int regAddress,
			       int len);

	native bool requestInProgress(Obj modbusRegHande);

	native bool getDone(Obj modbusRegHande,
			  int [] status,
			  int [] data
		);

	native void setRequest(Obj modbusRegHandle, bool request, int data);

	native void printInternalStateNative(Obj modbusRegHandle);

	/*****************************************************************************/


	action void printInternalStateBackend()
	{
		if (modbusRegHandle != null)
			printInternalStateNative(modbusRegHandle);
	}

	action void printInternalState()
	{
		printInternalStateBase();
	}

	action void forceRequestOnce()
	{
		forceRequest();
	}


	/************************* functions to process requests *********************************/
	bool swapBytesFlag()
	{
		Component comp = Sys.app.lookup(parent);
		Slot slot = comp?.type?.findSlot("swapBytes");
		return slot != null ? comp?.getBool(slot) : false;
	}

	bool swapWordsFlag()
	{
		Component comp = Sys.app.lookup(parent);
		Slot slot = comp?.type?.findSlot("swapWords");
		return slot != null ? comp?.getBool(slot) : false;
	}

	bool needUpdatePeriodically(int pollPeriodMs)
	{
		long curTime = Sys.ticks();
		long  elapsedMs = (curTime - lastUpdate)/(long)(1000*1000);
		return elapsedMs > (long)pollPeriodMs;
	}

	virtual bool needUpdate(int pollPeriodMs)
	{
		return false;
	}

	virtual void prepareDataBeforeWrite()
	{
	}

	virtual void processDataAfterRead()
	{
	}


	void updateRegRequest(int pollPeriodMs, bool force)
	{
		if (modbusRegHandle == null)
			return;

		if (requestInProgress(modbusRegHandle))
			return;


		bool need = needUpdate(getPollPeriodMs()) || force;
		if (need) {
			prepareDataBeforeWrite();

			if ((func == modbusWriteSingleHoldingRegister) ||
			    (func == modbusWriteMultipleHoldingRegisters)) {
				data = Exchange.swapBytesWords(data,
							       dataLen,
							       swapBytesFlag(),
							       swapWordsFlag());
			}
			setRequest(modbusRegHandle, true, data);
		}
	}

	void swapBytesWords()
	{
		data = Exchange.swapBytesWords(data,
						dataLen,
						swapBytesFlag(),
						swapWordsFlag())
	}

	void processDoneRequest()
	{
		long cur = Sys.ticks();
		actualUpdatePeriodMs := (int)((cur - lastUpdate)/(long)(1000*1000));
		lastUpdate = cur;

		totalRequests := totalRequests + 1;

		switch(lastStatus) {
			case statusOk:
				// last request was successful
				fault  := false
				status := statusOk;
				failStatusCnt = 0;
				downStatusCnt = 0;

				if ((func == modbusReadHoldingRegisters) ||
				    (func == modbusReadInputRegisters))
					swapBytesWords();

				processDataAfterRead();
				break;
			case statusFailed:
				failStatusCnt = failStatusCnt + 1;
				if (failStatusCnt > errStatusCntMax) {
					failStatusCnt = errStatusCntMax;
					fault := true;
					status := statusFailed;
				}
				break;
			case statusDown:
				downStatusCnt = downStatusCnt + 1;
				if (downStatusCnt > errStatusCntMax) {
					downStatusCnt = errStatusCntMax;
					fault  := true;
					status := statusDown;
				}
		}

		if (fault)
			totalErrors := totalErrors + 1;
	}

	void checkRequestResults()
	{
		if (modbusRegHandle == null)
			return;


		if (getDone(modbusRegHandle, tmp_status, tmp_data)) {
			// printMessage("done"); Sys.out.nl();
			data       = tmp_data[0];
			lastStatus = tmp_status[0];

			processDoneRequest();
		}
	}

	/************************* external accessors ***************************************/
	virtual void printInternalStateBase()
	{
		printMessage(""); Sys.out.print("lastUpdate        ${lastUpdate}").nl();
		printMessage(""); Sys.out.print("lastStatus        ${lastStatus}").nl();
		printMessage(""); Sys.out.print("failStatusCnt     ${failStatusCnt}").nl();
		printMessage(""); Sys.out.print("downStatusCnt     ${downStatusCnt}").nl();
		printMessage(""); Sys.out.print("modbusRegHandle   0x").print((modbusRegHandle != null ? "allocated" : "null")).nl();
		printMessage(""); Sys.out.print("data              0x").print(Sys.hexStr(data)).nl();
		printMessage(""); Sys.out.print("dataLen           ${dataLen}").nl();
		printMessage(""); Sys.out.print("func              ${func}").nl();
		printMessage(""); Sys.out.print("started           ${started}").nl();
		printMessage(""); Sys.out.print("tmp_data          ${tmp_data[0]}").nl();
		printMessage(""); Sys.out.print("tmp_status        ${tmp_status[0]}").nl();
		printMessage(""); Sys.out.print("net               ").printBool(net != null).nl();
		printMessage(""); Sys.out.print("dev               ").printBool(dev != null).nl();
	}

	bool checkModbusHandle()
	{
		return ((net != null) && (net.modbusHandle != null));
	}

	void startBackend()
	{
		getModbusNet();
		if (checkModbusHandle()) {
			modbusRegHandle = addRegister(net.modbusHandle,
						      getDevAddress(),
						      func,
						      address,
						      dataLen);
			lastUpdate = Sys.ticks();
		}
		started = true;
	}


	int   getPollPeriodMs()
	{
		return (net != null) ? net.pollPeriodMs: 0;
	}

	bool getParentEnable()
	{
		return (net != null) ? dev.enable && net.enable : false;
	}

	void getModbusNet()
	{
		if (dev != null)
			net = dev.getModbusNet();
		else
			net = null;
	}


	int getDevAddress()
	{
		return dev != null ? dev.address : -1;
	}

	void forceRequest()
	{
		updateRegRequest(getPollPeriodMs(), true);
	}
	/************************************************************************************/
	void updateBackendInfo()
	{
		if (modbusRegHandle != null)
			updateRegisterInfo(modbusRegHandle, getDevAddress(), func, address, dataLen);
	}


	void updateStatus() {
		if (!getParentEnable()) {
			fault := false;
			status := statusDown;
			return;
		}

		if (!checkModbusHandle() || (modbusRegHandle == null)) {
			fault := true;
			status := statusFailed;
			return;
		}

		if (net.status == statusFailed) {
			fault := true;
			status := statusFailed;
			return;
		}
	}

	virtual void enumToModbusFunc()
	{
	}



	/************************** standard component callbacks ************************/

	virtual override void loaded()
	{
		super.loaded();
		Component comp = Sys.app.lookup(parent);
		if (comp?.type?.is(ModbusSlaveDevice.type) == true) {
			dev = (ModbusSlaveDevice)comp;
			if (dev.started)
				startBackend();
		}
		updateStatus();
	}


	virtual override void execute()
	{
		super.execute();
		updateStatus();

		if (started) {
			updateRegRequest(getPollPeriodMs(), false);
			checkRequestResults();
		}

	}

	virtual override void remove()
	{
		super.remove();

		if ((modbusRegHandle != null) && checkModbusHandle()) {
			removeRegister(net.modbusHandle, modbusRegHandle);
			modbusRegHandle = null;
			net = null;
			dev = null;
		}
	}

	virtual override void changed(Slot slot)
	{
                super.changed(slot);
		if (slot == type.findSlot("modbusFunc"))
			enumToModbusFunc();

		if (modbusRegHandle == null)
			return;


		if ((slot == type.findSlot("modbusFunc")) ||
		    (slot == ModbusPoint.address))
			updateBackendInfo();
	}
}

@palette=false
class ModbusReadPoint extends ModbusPoint
{
	virtual override bool needUpdate(int pollPeriodMs)
	{
		return needUpdatePeriodically(pollPeriodMs);
	}

}

@palette=false
class ModbusWritePoint extends ModbusPoint
{
	define Str updateModeVals = "Periodically, OnChange, Both";

	define int updatePeriodically = 0;
	define int updateOnChange = 1;
	define int updateBoth = 2;

	@summary=false
	@config
	@range = updateModeVals
	property int updateMode = updatePeriodically;

	virtual bool needUpdateOnChange()
	{
		return false;
	}

	virtual override bool needUpdate(int pollPeriodMs)
	{
		bool ret = false;
		if ((updateMode == updatePeriodically) || (updateMode == updateBoth))
			ret = ret || needUpdatePeriodically(pollPeriodMs);

		if ((updateMode == updateOnChange) || (updateMode == updateBoth))
			ret = ret || needUpdateOnChange();

		return ret;
	}
}


@niagaraIcon="module://icons/x16/control/booleanPoint.png"
class ModbusReadPointBoolean extends ModbusReadPoint
{
	define Str modbusBoolReadFuncs = "readCoils, readDiscreteInputs";

	@summary=false
	@config
	@range = modbusBoolReadFuncs
	@min = 0
	property int modbusFunc = 1;

	@falseText="Off"
	@trueText="On"
	@readonly
	@allowNull=false
	property bool out;

	virtual override void enumToModbusFunc()
	{
		switch(modbusFunc) {
			case 0:
				func = modbusReadCoils;
				break;
			case 1:
				func = modbusReadDiscreteInputs;
				break;
			default:
				/* reset to correct value */
				func = modbusReadCoils;
				modbusFunc := 0;
				break;
		}
	}

	virtual override void loaded()
	{
		super.loaded();
		dataLen = 1;
		enumToModbusFunc();
	}


	virtual override void processDataAfterRead()
	{
		out :=(data & 1) != 0;
	}


}


@niagaraIcon="module://icons/x16/control/booleanPointWr.png"
class ModbusWritePointBoolean extends ModbusWritePoint
{
	define Str modbusBoolWriteFuncs = "writeSingleCoil, writeMultipleCoils";

	@summary=false
  	@config
	@range = modbusBoolWriteFuncs
	@min = 0
	property int modbusFunc = 0;


	@summary=true
	@config
	@falseText="Off"
	@trueText="On"
	@allowNull=false
	property bool in;

	bool lastValueIn;

	virtual override void printInternalStateBase()
	{
		super.printInternalStateBase();
		printMessage(""); Sys.out.print("lastValueIn       ${lastValueIn}").nl();
	}

	virtual override void enumToModbusFunc()
	{
		switch(modbusFunc) {
			case 0:
				func = modbusWriteSingleCoil;
				break;
			case 1:
				func = modbusWriteMultipleCoils;
				break;
			default:
				/* reset to correct value */
				func = modbusWriteSingleCoil;
				modbusFunc := 0;
				break;
		}
	}

	virtual override void loaded()
	{
		super.loaded();
		dataLen = 1;
		enumToModbusFunc();
	}

	virtual override void prepareDataBeforeWrite()
	{
		data = in ? 1 : 0;
	}

	virtual override bool needUpdateOnChange()
	{
		bool ret = (lastValueIn != in);
		lastValueIn = in;
		return ret;
	}
}


@palette=false
class ModbusReadPointNumeric extends ModbusReadPoint
{
	define Str modbusRegsReadFuncs = "readHoldingRegisters, readInputRegisters";

	@summary=false
