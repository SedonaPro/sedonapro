// 2026 SedonaPro: ports come from the board file (boards/<board>.toml,
// serial = [...]); the list below is used when the board has none.

**
** Serial ports of the controller for Modbus and serial protocols: port number
** 1..n = the board's serial list (boards/<board>.toml), else the defaults.
**
@palette=false
class SerialPorts {
	define int maxDefault = 5;

	define Str[maxDefault] defaultNames = { "",
				     "/dev/ttyUSB0",
				     "/dev/ttyUSB1",
				     "/dev/ttyS0",
				     "/dev/ttyS1"
	};

	static void _sInit()
	{
		int n = Hal.serialCount();
		if (n > 0)
		{
			SerialInfoPlatform.setMaxPortNum(n);
			SerialInfoPlatform.setPortName(0, "");
			for (int i = 0; i < n; i++)
				SerialInfoPlatform.setPortName(i + 1, Hal.serialName(i));
			return;
		}
		SerialInfoPlatform.setMaxPortNum(maxDefault - 1);
		for (int i = 0; i < maxDefault; i++)
			SerialInfoPlatform.setPortName(i, defaultNames[i]);
	}

	static internal inline SerialPorts singlet;
}
