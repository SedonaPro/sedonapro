@palette=false
class SpiBaseApi {
	define Str  spidev = "/dev/spidev1.0";

        static native int open(Str dev);
        static native int close(int fd);
        static native int sendByte(int fd, int freq_hz, int d);
        static native int initMode(int fd, bool cpol, bool cpha);
}


@palette=false
abstract class SpiWork extends DebugComponent {
	int  fd;

	@readonly
	property bool failed = false;

	property bool en = false;
	
	@readonly
	property bool eno = false;


	abstract bool work();

	virtual override void execute() {
		bool fail = false;
		super.execute();
		if (en) {
			fd = SpiBaseApi.open(SpiBaseApi.spidev);
		
			fail = (fd < 0);
			if (!fail) {
				fail = work();
				SpiBaseApi.close(fd);
			}
		}

		failed := fail;
		eno := en && (!fail);
	}
}

class SpiInit extends SpiWork {
	@config
	property bool cpol = false;

	@config
	property bool cpha = false;

	virtual override bool work() {
		return (SpiBaseApi.initMode(fd, cpol, cpha) == -1);
	}
}

class SpiReadWriteByte extends SpiWork {
	property int in;

	@readonly
	property int out;

	@config
	property int freq_hz = 100000;

	virtual override bool work() {
		out := 	SpiBaseApi.sendByte(fd, freq_hz, in);
		return (out == -1);
	}
}


