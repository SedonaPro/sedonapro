class BoolToInt extends Component
{
	property bool in;

	@readonly
	property int out;

	static int boolToInt(bool in)
	{
		int tmp;

		if (in != null) {
			tmp = in ? 1 : 0;
		}
		else
			tmp = 2;

		return tmp;
	}

	virtual override void execute()
	{
		out := boolToInt(in);
	}
}

class UWord2SWord extends Component
{

	property int in;

	@readonly
	property int out;

	static int uWord2SWord(int d)
	{
		d = d & 0xFFFF;
		d = (d > 0x7FFF) ? d - 0x10000  : d;
		return d;
	}

	virtual override void execute()
	{
		out := uWord2SWord(in);
	}
}

class SWord2UWord extends Component
{
	property int in;

	@readonly
	property int out;

	virtual override void execute()
	{
		out := in & 0xFFFF;
	}
}



class L2I extends Component
{
	property long in;

	@readonly
	property int out;


	virtual override void execute()
	{
		out := (int)in;
	}
}


class I2L extends Component
{
	property int in;

	@readonly
	property long out;


	virtual override void execute()
	{
		out := (long)in;
	}
}
