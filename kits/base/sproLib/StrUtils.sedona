@palette=false
class StrUtils
{
	static bool appendBytes(Str dst, byte[] src, int bytesCopy, int maxDstLen)
	{
		bool res = true;

		if ((src == null) || (dst == null))
			return false;

		int len = dst.length();
		if ((len + bytesCopy) > maxDstLen) {
			bytesCopy = len - maxDstLen;
			res = false;
		}

		for(int i = 0; i < bytesCopy; i++) {
			dst.set(len + i, src[i]);
		}
		dst.set(len + bytesCopy, 0);
		return res;
	}

	static bool appendStr(Str dst, Str src, int maxDstLen)
	{
		int bytesCopy = src.length();
		return appendBytes(dst, src.toBytes(), bytesCopy, maxDstLen);
	}
}
