**
** One value from up to 4 sensors, leaving out the invalid ones:
** average, minimum, maximum, median (2-of-3 voting with 3 sensors) or
** the first valid one (main sensor with backups).  Unlinked inputs are
** null and do not count.
**
@niagaraIcon="module://icons/x16/control/numericPoint.png"
class Select4 extends Component
{
  property float in1 = null
  property float in2 = null
  property float in3 = null
  property float in4 = null

  define Str modeRange = "avg, min, max, median, first"
  define int avg = 0
  define int min = 1
  define int max = 2
  define int median = 3
  define int first = 4

  @config @range=modeRange property byte mode = 0

  ** fewer valid inputs than this: out is null, status inputBad
  @config @min=1 @max=4 property int minValid = 1

  ** spread is set when valid inputs differ by more than this (0 = no check)
  @config @min=0 property float maxSpread = 0.0f

  @readonly @summary property float out

  ** valid inputs
  @readonly property int valid

  ** valid inputs disagree by more than maxSpread
  @readonly property bool spread

  ** input used in first mode (1..4), 0 otherwise
  @readonly property int used

  ** ok, inputBad (some input invalid, out still computed), alarm (too few valid)
  @readonly @range=Pro.statusRange property byte status

  virtual override void execute()
  {
    int n = 0
    int firstIdx = 0
    for (int i = 1; i <= 4; i++)
    {
      float v = input(i)
      if (!Pro.valid(v)) continue
      v_[n] = v
      n++
      if (firstIdx == 0) firstIdx = i
    }
    valid := n
    used := 0
    if (n < minValid || n == 0)
    {
      out := null
      spread := false
      status := Pro.alarm
      return
    }
    // sort the valid values
    for (int i = 1; i < n; i++)
    {
      float v = v_[i]
      int j = i - 1
      while (j >= 0 && v_[j] > v) { v_[j + 1] = v_[j]; j-- }
      v_[j + 1] = v
    }
    spread := maxSpread > 0.0f && v_[n - 1] - v_[0] > maxSpread
    if (mode == min) out := v_[0]
    else if (mode == max) out := v_[n - 1]
    else if (mode == median) out := (n % 2 == 1) ? v_[n / 2] : (v_[n / 2 - 1] + v_[n / 2]) / 2.0f
    else if (mode == first) { out := input(firstIdx); used := firstIdx }
    else
    {
      float s = 0.0f
      for (int i = 0; i < n; i++) s += v_[i]
      out := s / (float)n
    }
    status := n < linked() ? Pro.inputBad : Pro.ok
  }

  float input(int i)
  {
    if (i == 1) return in1
    if (i == 2) return in2
    if (i == 3) return in3
    return in4
  }

  ** inputs with a link to them
  private int linked()
  {
    int n = 0
    for (Link l = linksTo; l != null; l = l.nextTo)
      if (l.toSlot == Select4.in1.id || l.toSlot == Select4.in2.id || l.toSlot == Select4.in3.id || l.toSlot == Select4.in4.id) n++
    return n
  }

  inline float[4] v_
}
