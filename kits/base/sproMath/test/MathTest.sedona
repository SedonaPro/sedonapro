class  MathTest extends Test
{
	static bool checkAbsError(float in, float need)
	{
		float err;
		float absErr;
		err = in - need
		absErr = (err < 0.0) ? -1.0 * err : err;
		return err < 0.1;
	}




	static void testFabs()
	{
		assert(Math.fabs(0.0) == 0.0);
		assert(Math.fabs(1.0) == 1.0);
		assert(Math.fabs(-5.0) == 5.0);
		assert(checkAbsError(Math.fabs(-5.35) - 5.35, 0.1));
	}

	static void testAbs()
	{
		assert(Math.abs(0) == 0);
		assert(Math.abs(1) == 1);
		assert(Math.abs(-1) == 1);
	}

	static void testArccos()
	{
		assert(checkAbsError(Math.arccos(0.0), Math.Pi/2.0));
		assert(Math.arccos(1.0) == 0.0);
		assert(checkAbsError(Math.arccos(-1.0), Math.Pi));
		assert(Math.arccos(-3.0) == null);
		assert(Math.arccos(1.2) == null);
	}

	static void testArcsin()
	{
		assert(checkAbsError(Math.arcsin(0.0), 0.01));
		assert(checkAbsError(Math.arcsin(1.0), Math.Pi/2.0));
		assert(checkAbsError(Math.arcsin(-1.0),- Math.Pi/2.0));
		assert(Math.arcsin(-3.0) == null);
		assert(Math.arcsin(1.2) == null);
	}

	static void testArctan()
	{
		assert(checkAbsError(Math.arctan(0.0), 0.01));
		assert(checkAbsError(Math.arctan(1.0), Math.Pi/4.0));
		assert(checkAbsError(Math.arctan(-1.0), -Math.Pi/4.0));
		assert(checkAbsError(Math.arctan(-3.0), -1.249045772));
	}

	static void testArctan2()
	{
		assert(checkAbsError(Math.arctan2(0.0, 1.0), 0.0));
		assert(checkAbsError(Math.arctan2(1.0, 1.0), Math.Pi/4.0));
		assert(checkAbsError(Math.arctan2(1.0, -1.0), 3.0*Math.Pi/4.0));
		assert(checkAbsError(Math.arctan2(-1.0, -1.0), - 3.0*Math.Pi/4.0));
		assert(checkAbsError(Math.arctan2(1.0, 0.0), Math.Pi/2.0));
	}



	static void testLog()
	{
		assert(Math.log(1.0) == 0.0);
		assert(checkAbsError(Math.log(Math.E),1.0));
		assert(checkAbsError(Math.log(28.0), 3.33220451));
		assert(Math.log(-1.0) == null);
	}


	static void testLog10()
	{
		assert(Math.log10(1.0) == 0.0);
		assert(checkAbsError(Math.log10(100.0),2.0));
		assert(checkAbsError(Math.log10(28.0), 1.447158));
		assert(Math.log10(-3.0) == null);
	}
}
