@palette=false
class Math {
	define float Pi = 3.14159265358979323846;
	define float E  = 2.718281828459045235360287471352;

	static native float arccos(float in);
	static native float arcsin(float in);
	static native float arctan(float in);
	static native float arctan2(float in1, float in2);
	static native float ceil(float in);
	static native float cos(float in);
	static native float cosh(float in);
	static native float exp(float in);
	static native float floor(float in);
	static native float fmod(float in1, float in2);
	static native void  frexp(float in, float[1] mantissa, int[1] exp);
	static native float ldexp(float in);
	static native float log(float in);
	static native float log10(float in);
	static native void  modf(float in, float[1] intPart, float[] fracPart);
	static native float pow(float base, float exponent);
	static native float sin(float in);
	static native float sinh(float in);
	static native float sqrt(float in);
	static native float tan(float in);
	static native float tanh(float in);

	static native float cbrt(float in);
	static native float arccosh(float in);
	static native float arcsinh(float in);
	static native float arctanh(float in);

	static float fabs(float value)
	{
		return (value < 0.0) ? -1.0 * value : value;

	}

	static int abs(int value)
	{
		return (value < 0) ? -1 * value : value;

	}

	static long labs(long value)
	{
		return (value < 0L) ? -1L * value : value;

	}
}

class Arccos extends Component
{
	property float in;

	@readonly
	property float out;

	virtual override void execute()
	{
		out := Math.arccos(in);
	}
}

class Arcsin extends Component
{
	property float in;

	@readonly
	property float out;

	virtual override void execute()
	{
		out := Math.arcsin(in);
	}
}


class Arctan extends Component
{
	property float in;

	@readonly
	property float out;

	virtual override void execute()
	{
		out := Math.arctan(in);
	}
}

class Arctan2 extends Component
{
	property float y;
	property float x;

	@readonly
	property float out;

	virtual override void execute()
	{
		out := Math.arctan2(y, x);
	}
}

class Ceil extends Component
{
	property float in;

	@readonly
	property float out;

	virtual override void execute()
	{
		out := Math.ceil(in);
	}
}

class Cos extends Component
{
	property float in;

	@readonly
	property float out;

	virtual override void execute()
	{
		out := Math.cos(in);
	}
}

class Cosh extends Component
{
	property float in;

	@readonly
	property float out;

	virtual override void execute()
	{
		out := Math.cosh(in);
	}
}

class Exp extends Component
{
	property float in;

	@readonly
	property float out;

	virtual override void execute()
	{
		out := Math.exp(in);
	}
}

class Floor extends Component
{
	property float in;

	@readonly
	property float out;

	virtual override void execute()
	{
		out := Math.floor(in);
	}
}

class Fmod extends Component
{
	property float num;
	property float denom;

	@readonly
	property float rem;

	virtual override void execute()
	{
		rem := Math.fmod(num, denom);
	}
}

class Frexp extends Component
{
	property float in;

	@readonly
	property float mantissa;

	@readonly
	property int exp;

	static inline float[1] tmp_mantissa;
	static inline int[1] tmp_exp;

	virtual override void execute()
	{
		Math.frexp(in, tmp_mantissa, tmp_exp);
		mantissa := tmp_mantissa[0];
		exp := tmp_exp[0];
	}
}

class Ldexp extends Component
{
	property float in;

	@readonly
	property float out;

	virtual override void execute()
	{
		out := Math.ldexp(in);
	}
}

class Log extends Component
{
	property float in;

	@readonly
	property float out;

	virtual override void execute()
	{
		out := Math.log(in);
	}
}

class Log10 extends Component
{
	property float in;

	@readonly
	property float out;

	virtual override void execute()
	{
		out := Math.log10(in);
	}
}

class Modf extends Component
{
	property float in;

	@readonly
	property float intPart;

	@readonly
	property float fracPart;

	static inline float[1] tmp_intPart;
	static inline float[1] tmp_fracPart;

	virtual override void execute()
	{
		Math.modf(in, tmp_intPart, tmp_fracPart);
		intPart := tmp_intPart[0];
		fracPart := tmp_fracPart[0];
	}
}

class Pow extends Component
{
	property float base;

	property float exp;

	@readonly
	property float out;

	virtual override void execute()
	{
		out := Math.pow(base, exp);
	}
}

