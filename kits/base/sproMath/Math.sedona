class MathConstants extends Component
{
	@readonly
	property float Pi;

	@readonly
	property float E;


	@readonly
	property float Sqrt2;

	@readonly
	property float Sqrt3;


	virtual override void loaded()
	{
		Pi := Math.Pi;
		E := Math.E;
		Sqrt2 := Math.sqrt(2.0);
		Sqrt3 := Math.sqrt(3.0);
	}
}
